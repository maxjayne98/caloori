# local | supabase. No account or server needed for local mode.
NEXT_PUBLIC_STORAGE_DRIVER=local
# Supabase adapter uses public credentials + Auth + RLS. NEVER add a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public Web Push key for meal reminders (pair with VAPID_PRIVATE_KEY in the nourish-push function).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
